# Copy this file to .env and paste your keys. Never commit .env.

# Alpaca paper account: trading + free price history from 2016
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# SEC asks for a name and contact email in every request (insider data, fundamentals, sectors)
SEC_USER_AGENT=Your Name your.email@example.com

# Nasdaq Data Link (free account) for the WIKI Prices archive, to March 2018 ...
NASDAQ_DATA_LINK_API_KEY=
# ... or, instead, the path to a WIKI_PRICES csv/zip you downloaded yourself (e.g. a Kaggle mirror)
WIKI_PRICES_FILE=

# Tiingo free tier: only used for stocks missing elsewhere (mainly post-2018 delistings)
TIINGO_API_KEY=

# Stooq backup (optional). Since 2026 it needs a free key from a captcha page:
# https://stooq.com/q/d/?s=spy.us&get_apikey  -- or the path to a bulk zip from stooq.com/db/h/
STOOQ_API_KEY=
STOOQ_BULK_FILE=

# Financial Modeling Prep (optional; only used with `trader download --fmp` if the probe says it helps)
FMP_API_KEY=
